{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "required":["decision_id","candidate_id","run_id","current_stage","decision","reason_codes","evidence_ids","next_stage","decision_source","timestamp_utc","policy_version"],
  "properties":{
    "decision_id":{"type":"string"},"candidate_id":{"type":"string"},"run_id":{"type":"string"},"current_stage":{"type":"string"},
    "decision":{"enum":["ADVANCE","DROP","KEEP","DEFER","BLOCKED"]},"reason_codes":{"type":"array","items":{"type":"string"}},"evidence_ids":{"type":"array","items":{"type":"string"}},"next_stage":{"type":["string","null"]},"decision_source":{"enum":["RULE","HUMAN","SCHEDULER","ESTIMATOR_ASSISTED"]},"timestamp_utc":{"type":"string"},"policy_version":{"type":"string"},
    "estimator":{"type":["object","null"]}
  }
}
